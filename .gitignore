__pycache__/
*.pyc
*.pyo
*.pyd
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/

# Python packaging
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Coverage / test reports
.coverage
.coverage.*
coverage.xml
htmlcov/

# Editor / IDE
.vscode/
.idea/
*.swp
