# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/

# Python packaging
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Coverage / test reports
.coverage
.coverage.*
coverage.xml
htmlcov/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.orig
.DS_Store

# Windows OS
Thumbs.db
desktop.ini

# ML experiment tracking (preemptive — currently unused, but tensorboard,
# wandb, mlflow, lightning are easy to wire in later and they all write
# large per-run directories that should never go to git)
runs/
mlruns/
wandb/
lightning_logs/

# Logs
logs/
*.log

# Temp files we sometimes create during doc edits
_*_temp.md
*.tmp

# Calibration data — feature_history CSVs are too large for git.
# Keep regenerated artifacts (weights, threshold JSON, sweep CSVs) out of
# the ignore list so the trained model and its operating point are
# committed alongside the code that produced them.
calibration/feature_history_*.csv
calibration/synthetic_history.csv
calibration/shock_validation.csv

# Eval-specific per-run artifacts (kept locally for debugging; the
# operating-point .json/.csv produced at training time are still committed).
calibration/tcn_threshold_eval_*
calibration/tcn_threshold_sweep_eval_*

# Inspection plot directories (image artifacts from tests/inspect_shocks.py).
calibration/inspection*/

# HL liquidations cache (re-downloaded by fetch_history_hyperliquid.py on demand).
calibration/hl_liquidations.csv

# Horizon-variant weight backups (only the canonical operating-point weights
# are committed; backups like _H100.pt, _H500.pt are local-only).
calibration/tcn_weights_*_H*.pt

# PPO step-checkpoints from train_ppo.py — only the final ppo_weights_<SYM>.pt
# and the random-init sanity baseline are worth tracking; intermediate step
# files are noise.
calibration/ppo_weights_*_step*.pt
# Per-run training log + eval/HPO/Layer-4 report JSON — outputs, not source.
calibration/ppo_train_log_*.csv
calibration/eval_ppo_*.json
calibration/hpo_smoke_*.json
calibration/layer4_validation_*.json

# Claude Code session metadata (worktrees, agent state).
.claude/
